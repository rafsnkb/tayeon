# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# scratch/working files (e.g. Figma API dumps for design-to-code work)
/.tmp

# dependencies
/node_modules
/admin/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/admin/.next/
/admin/out/

# production
/build
/admin/build

# misc
.DS_Store
*.pem

# raw design source files (PSD etc.) — not needed at runtime, too large for git
/resources/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/node_modules/
functions/lib/

# Editor/OS
.vscode/
.idea/
Thumbs.db

# Claude local settings
.claude/settings.local.json
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/types/

# Playwright MCP가 브라우저 확인 중 남기는 스크린샷/스냅샷
.playwright-mcp/

# impeccable 디자인 검수 스킬의 작업 폴더(캡처·측정 스크립트) — 커밋 대상 아님
.impeccable/

# 목업과 디자인 원본은 저장소에 두지 않는다(사용자 결정, 2026-09-26). 로컬에는 그대로 남는다.
#
# 여기 있는 것들은 **런타임에 읽히지 않는다** — 목업은 작업할 때 보는 것이고, texture 는
# public/ 로 복사되거나(bi·btn_kakao·x_logo·Instagram·appicon) scripts/build-pass-art.cjs 의
# 입력으로만 쓰인다(prizebg_tier_*·timepass_*). web 에 실제로 나가는 사본은 public/ 아래에
# 있고 그쪽은 계속 커밋된다. 원본이 없으면 이용권 아트를 **다시 뽑지** 못할 뿐이다.
#
# ⚠️ asset/resource(카드 그림 78장)와 asset/font(Pretendard)는 여기 넣지 말 것 —
#    전자는 /api/tarot/cards 가 디스크에서 직접 읽고, 후자는 next/font 가 빌드에 쓴다.
/asset/Screen/
/asset/texture/
