# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# scratch/working files (e.g. Figma API dumps for design-to-code work)
/.tmp

# dependencies
/node_modules
/admin/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/admin/.next/
/admin/out/

# production
/build
/admin/build

# misc
.DS_Store
*.pem

# raw design source files (PSD etc.) — not needed at runtime, too large for git
/resources/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Firebase
.firebase/
firebase-debug.log
firestore-debug.log
ui-debug.log
functions/node_modules/
functions/lib/

# Editor/OS
.vscode/
.idea/
Thumbs.db

# Claude local settings
.claude/settings.local.json
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-sync/types/

# Playwright MCP가 브라우저 확인 중 남기는 스크린샷/스냅샷
.playwright-mcp/

# impeccable 디자인 검수 스킬의 작업 폴더(캡처·측정 스크립트) — 커밋 대상 아님
.impeccable/

# 이용권 상품 원본 아트워크 — 1254px 정사각 18장으로 합쳐 45MB라 저장소에 두지 않는다
# (사용자 결정, 2026-09-25). web 에 나가는 건 scripts/build-pass-art.cjs 가 만든
# public/pass/*.webp 뿐이고 그쪽은 커밋된다. 원본이 없으면 그 스크립트만 못 돌린다.
asset/texture/prizebg_tier_*.jpg
asset/texture/timepass_*.png
