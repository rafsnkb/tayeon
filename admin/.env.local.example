NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

FIREBASE_SERVICE_ACCOUNT_EMAIL=

# Comma-separated Firebase Auth UIDs allowed to use this admin app.
# Enable Google as a sign-in provider in the Firebase console (Authentication > Sign-in method),
# then sign in once with the admin's Google account here to create the Firebase Auth user,
# copy its UID from the console (Authentication > Users), and add it here.
ADMIN_UIDS=

# 포트원(PortOne) V2 결제 취소(환불) API 호출용 — 타연 본체(.env.local)와 같은 값.
PORTONE_API_SECRET=

# 로컬에서 Firebase Admin 이 쓸 자격증명 경로. 한 머신에서 여러 GCP 프로젝트를 개발하면
# 공용 ADC(%APPDATA%/gcloud)가 서로 덮어써지므로, 프로젝트 전용 ADC 를 만들어 지정한다.
#   CLOUDSDK_CONFIG 를 전용 폴더로 지정 → gcloud auth application-default login
# 배포 환경(App Hosting)에서는 비워 둔다 — 런타임이 자체 자격증명을 준다.
GOOGLE_APPLICATION_CREDENTIALS=
