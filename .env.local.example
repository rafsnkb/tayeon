NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

NEXT_PUBLIC_KAKAO_REST_API_KEY=
NEXT_PUBLIC_KAKAO_REDIRECT_URI=
KAKAO_CLIENT_SECRET=
FIREBASE_SERVICE_ACCOUNT_EMAIL=

ANTHROPIC_API_KEY=

# 포트원(PortOne) V2 결제 연동 — https://admin.portone.io
# 스토어 ID / 채널 키는 콘솔 > 결제 연동 > 연동 정보에서 확인.
NEXT_PUBLIC_PORTONE_STORE_ID=
# 일반결제(횟수제/시간제 이용권 구매)용 채널 키
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 정기결제(빌링키)용 채널 키
NEXT_PUBLIC_PORTONE_BILLING_CHANNEL_KEY=
# V2 API Secret — 콘솔 > 결제 연동 > 연동 정보에서 발급. 서버 전용(NEXT_PUBLIC_ 접두사 없음).
PORTONE_API_SECRET=
# 웹훅 시크릿 — 콘솔 > 결제 연동 > 연동 관리 > 결제알림(Webhook) 관리에서 발급.
PORTONE_WEBHOOK_SECRET=
# 판매 종료 전 승인된 코인 결제만 사후 지급할 수 있는 컷오프 시각(ISO 8601, UTC).
# 전환 배포 직전 실제 판매 종료 시각으로 설정. 미설정 시 기존 코인 결제는 지급하지 않음.
LEGACY_COIN_PAID_BEFORE=

# 심사(KG이니시스) 전용 ID/PW 로그인 — 아래 값을 정확히 일치할 때만 동작. 일반 회원가입 기능
# 아님. 심사 끝나면 지우거나 값을 바꿔서 비활성화 가능.
PG_REVIEW_TEST_ID=
PG_REVIEW_TEST_PASSWORD=

# ── 운영 알림 (Discord) ─────────────────────────────────────────────
# 서버 설정 > 연동 > 웹후크에서 만든 URL. 없으면 알림을 건너뛴다(에러는 안 난다).
# 아는 사람이면 누구나 그 채널에 글을 쓸 수 있는 비밀값이니 커밋하지 말 것.
DISCORD_WEBHOOK_URL=
# 고객센터 문의용 채널. 비워 두면 위 기본 채널로 같이 간다.
DISCORD_SUPPORT_WEBHOOK_URL=

# ── 서버 간 호출 ───────────────────────────────────────────────────
# 어드민/스케줄러가 본체·어드민 내부 API를 부를 때 쓰는 공유 시크릿. 세 앱에 같은 값을 넣는다.
# 비워 두면 해당 엔드포인트가 아예 닫힌다(503).
INTERNAL_API_SECRET=
# 어드민이 본체 알림 창구를 부를 주소. 로컬은 http://localhost:3000
TAYEON_BASE_URL=
# 스케줄러가 어드민 자동 승인을 부를 주소. 로컬은 http://localhost:3100
ADMIN_BASE_URL=

# ── 환불 자동 승인 ─────────────────────────────────────────────────
# 기본은 드라이런(판정·알림만 하고 실제 결제 취소는 안 함). 실제로 켜려면 정확히 "on".
# 사람 확인 없이 돈이 나가기 시작하는 스위치다 — 며칠 드라이런으로 돌려보고 켤 것.
REFUND_AUTO_APPROVE=
