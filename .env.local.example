ANTHROPIC_API_KEY=

# 포트원(PortOne) V2 결제 연동 — https://admin.portone.io
# 스토어 ID / 채널 키는 콘솔 > 결제 연동 > 연동 정보에서 확인.
NEXT_PUBLIC_PORTONE_STORE_ID=
# 일반결제(횟수제/시간제 이용권 구매)용 채널 키
NEXT_PUBLIC_PORTONE_CHANNEL_KEY=
# 정기결제(빌링키)용 채널 키
NEXT_PUBLIC_PORTONE_BILLING_CHANNEL_KEY=
# V2 API Secret — 콘솔 > 결제 연동 > 연동 정보에서 발급. 서버 전용(NEXT_PUBLIC_ 접두사 없음).
PORTONE_API_SECRET=
# 웹훅 시크릿 — 콘솔 > 결제 연동 > 연동 관리 > 결제알림(Webhook) 관리에서 발급.
PORTONE_WEBHOOK_SECRET=
# 판매 종료 전 승인된 코인 결제만 사후 지급할 수 있는 컷오프 시각(ISO 8601, UTC).
# 전환 배포 직전 실제 판매 종료 시각으로 설정. 미설정 시 기존 코인 결제는 지급하지 않음.
LEGACY_COIN_PAID_BEFORE=

# 심사(KG이니시스) 전용 ID/PW 로그인 — 아래 값을 정확히 일치할 때만 동작. 일반 회원가입 기능
# 아님. 심사 끝나면 지우거나 값을 바꿔서 비활성화 가능.
PG_REVIEW_TEST_ID=
PG_REVIEW_TEST_PASSWORD=
